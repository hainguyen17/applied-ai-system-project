# Copy to .env (never commit it) or export in your shell.
# Without a key the app runs fully offline with the rule-based parser.
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-haiku-4-5)
CLAUDE_MODEL=
# Optional: force the offline parser even when a key is set (auto | claude | mock)
VIBEMATCH_LLM=auto
